# BombBlob 环境变量示例。本地开发：cp .env.example .env 后按需修改。
# Docker：用 docker run -e 变量=值 传入（见 README）。

PORT=8080
PUBLIC_URL=http://127.0.0.1:8080
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/bombblob

# 登录方式
LOGIN_GUEST=true
LOGIN_GITHUB=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 传输加密用的 RSA 私钥（与 public/js/rsa-public.js 中写死的公钥配对）。
# ⚠ 这是公开在仓库里的默认密钥，只为了克隆后能直接运行；任何人都能用它解密使用默认密钥的流量。
#   正式部署前请运行 python scripts/gen_rsa.py 生成自己的密钥对（会更新 rsa-public.js 并把私钥写进 .env）。
RSA_PRIVATE_
